# Build Composer dependencies with a PHP version compatible with Laravel 13.
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

# Build Vite assets separately; this project has no package-lock.json.
FROM node:22-alpine AS assets

WORKDIR /app

COPY package.json ./
RUN npm install --ignore-scripts

COPY . .
RUN npm run build

# Run Laravel with FrankenPHP. Vercel routes all traffic to this container.
FROM dunglas/frankenphp:php8.4-alpine

WORKDIR /app

# PostgreSQL driver required by Neon.
RUN install-php-extensions pdo_pgsql

COPY . .
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build

# Generate Laravel package manifests without caching environment-bound config.
RUN php artisan package:discover --ansi --no-interaction \
    && mkdir -p \
        /tmp/storage/framework/cache/data \
        /tmp/storage/framework/sessions \
        /tmp/storage/framework/views \
        /tmp/storage/logs \
    && chmod -R 777 /tmp/storage

# Vercel exposes port 80 to container traffic. Laravel writes only to /tmp.
ENV SERVER_NAME=:80 \
    SERVER_ROOT=/app/public \
    LARAVEL_STORAGE_PATH=/tmp/storage

EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
