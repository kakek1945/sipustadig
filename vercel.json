{
  "name": "Sipustadig",
  "version": 2,
  "buildCommand": "npm ci && npm run build",
  "outputDirectory": "public",
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "database",
    "CACHE_STORE": "database",
    "QUEUE_CONNECTION": "sync",
    "FILESYSTEM_DISK": "s3"
  },
  "functions": {
    "public/index.php": {
      "runtime": "container"
    }
  },
  "routes": [
    {
      "src": "^/build/(?<path>.*)$",
      "dest": "/build/$path",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/storage/(?<path>.*)$",
      "dest": "/storage/$path",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "^(?<path>.*)$",
      "dest": "/index.php?path=$path"
    }
  ],
  "public": true
}
